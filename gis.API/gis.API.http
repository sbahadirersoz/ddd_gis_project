### Line API checks. Run with Docker: docker compose up -d --build
### Run the two create requests first; the first one saves its id as {{lineId}}.

@host = http://localhost:8080
@lines = {{host}}/api/v1/lines
@missingId = 00000000-0000-0000-0000-000000000001

### Create line A (saves lineId)
POST {{lines}}/create
Content-Type: application/json

{
  "coordinates": [
    { "longitude": 29.0000, "latitude": 41.0000 },
    { "longitude": 29.0100, "latitude": 41.0100 }
  ],
  "lineName": "check-A-{{$timestamp}}",
  "lineDescription": "api check"
}

> {%
client.global.set("lineId", response.body.id);
client.global.set("lineName", response.body.name);
%}

### Create line B, about 1 km from A
POST {{lines}}/create
Content-Type: application/json

{
  "coordinates": [
    { "longitude": 29.0000, "latitude": 41.0100 },
    { "longitude": 29.0100, "latitude": 41.0200 }
  ],
  "lineName": "check-B-{{$timestamp}}",
  "lineDescription": "api check"
}

### closestById, existing id -> 200
GET {{lines}}/closestById?id={{lineId}}

### closestById, missing id -> 404 ENTITY_NOT_FOUND
GET {{lines}}/closestById?id={{missingId}}

### inRange, existing id -> 200
GET {{lines}}/inRange?id={{lineId}}&DistanceByMeters=5000

### inRange, missing id -> 404 ENTITY_NOT_FOUND
GET {{lines}}/inRange?id={{missingId}}&DistanceByMeters=5000

### closesByCount, existing id -> 200
GET {{lines}}/closesByCount?id={{lineId}}&count=2

### closesByCount, missing id -> 404 ENTITY_NOT_FOUND
GET {{lines}}/closesByCount?id={{missingId}}&count=2

### closesByCount, count=-1 -> 400 INVALID_QUERY_COUNT
GET {{lines}}/closesByCount?id={{lineId}}&count=-1

### closesByCount, count=0 -> 400 INVALID_QUERY_COUNT
GET {{lines}}/closesByCount?id={{lineId}}&count=0

### closesByCount, count=13 -> 400 INVALID_QUERY_COUNT
GET {{lines}}/closesByCount?id={{lineId}}&count=13

### PATCH checks. Run "Create line A" first; each request below changes line A.

### PATCH description only -> 200, desc = "patched desc"
PATCH {{lines}}
Content-Type: application/json

{ "id": "{{lineId}}", "lineDescription": "patched desc" }

### PATCH coordinates only -> 200, new wkt
PATCH {{lines}}
Content-Type: application/json

{
  "id": "{{lineId}}",
  "coordinates": [
    { "longitude": 29.0000, "latitude": 41.0000 },
    { "longitude": 29.0200, "latitude": 41.0200 }
  ]
}

### PATCH same coordinates again -> 400 SAME_CREDENTIALS (200 here means the DB-loaded coordinates do not compare equal)
PATCH {{lines}}
Content-Type: application/json

{
  "id": "{{lineId}}",
  "coordinates": [
    { "longitude": 29.0000, "latitude": 41.0000 },
    { "longitude": 29.0200, "latitude": 41.0200 }
  ]
}

### PATCH same name + new description -> 200
PATCH {{lines}}
Content-Type: application/json

{ "id": "{{lineId}}", "lineName": "{{lineName}}", "lineDescription": "same name check" }

### PATCH same status (0 = ACTIVE) + new description -> 200
PATCH {{lines}}
Content-Type: application/json

{ "id": "{{lineId}}", "status": 0, "lineDescription": "same status check" }

### PATCH missing id -> 404 ENTITY_NOT_FOUND
PATCH {{lines}}
Content-Type: application/json

{ "id": "{{missingId}}", "lineDescription": "nobody" }

### GET/DELETE checks. Run after the PATCH checks; DELETE removes line A.

### GET by id, existing -> 200
GET {{lines}}/{{lineId}}

### GET by id, missing -> 404 ENTITY_NOT_FOUND
GET {{lines}}/{{missingId}}

### DELETE line A -> 200
DELETE {{lines}}/{{lineId}}

### GET deleted line A -> 404 ENTITY_NOT_FOUND (soft delete persisted and filtered)
GET {{lines}}/{{lineId}}

### DELETE line A again -> 404 ENTITY_NOT_FOUND
DELETE {{lines}}/{{lineId}}

### LonLat checks. Run "Create line A" and "Create line B" first (DELETE above removes A, so re-run create A).

### closestByLatLon -> 200, nearest line
GET {{lines}}/closestByLatLon?longitude=29.005&latitude=41.005

### closestByLatLon, latitude missing -> 400 MISSING_COORDINATE
GET {{lines}}/closestByLatLon?longitude=29.005

### closestByLatLon, latitude out of range -> 400 LATITUDE range error
GET {{lines}}/closestByLatLon?longitude=29.005&latitude=95

### inRange/byLatLon -> 200, lines within 5 km
GET {{lines}}/inRange/byLatLon?longitude=29.005&latitude=41.005&DistanceByMeters=5000

### inRange/byLatLon, far away -> 200 []
GET {{lines}}/inRange/byLatLon?longitude=10&latitude=10&DistanceByMeters=100

### closesByLatLon, count=2 -> 200, two nearest lines
GET {{lines}}/closesByLatLon?longitude=29.005&latitude=41.005&count=2

### closesByLatLon, count=13 -> 400 INVALID_QUERY_COUNT
GET {{lines}}/closesByLatLon?longitude=29.005&latitude=41.005&count=13

### Re-create after delete. Needs the LineNameUniqueExceptSoftDeleted migration applied.

### Create line C (saves lineCId and lineCName)
POST {{lines}}/create
Content-Type: application/json

{
  "coordinates": [
    { "longitude": 29.1000, "latitude": 41.1000 },
    { "longitude": 29.1100, "latitude": 41.1100 }
  ],
  "lineName": "check-C-{{$timestamp}}",
  "lineDescription": "re-create check"
}

> {%
client.global.set("lineCId", response.body.id);
client.global.set("lineCName", response.body.name);
%}

### DELETE line C -> 200
DELETE {{lines}}/{{lineCId}}

### Create again with line C's name -> 200 (was 500 before the filtered index)
POST {{lines}}/create
Content-Type: application/json

{
  "coordinates": [
    { "longitude": 29.1000, "latitude": 41.1000 },
    { "longitude": 29.1100, "latitude": 41.1100 }
  ],
  "lineName": "{{lineCName}}",
  "lineDescription": "re-created"
}

### Same name while the new line is active -> 409 VALUE_ALREADY_EXIST_IN_DB
POST {{lines}}/create
Content-Type: application/json

{
  "coordinates": [
    { "longitude": 29.1000, "latitude": 41.1000 },
    { "longitude": 29.1100, "latitude": 41.1100 }
  ],
  "lineName": "{{lineCName}}",
  "lineDescription": "duplicate"
}
